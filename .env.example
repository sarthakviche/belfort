# Copy this file to .env and fill in what you need. Everything is optional. Never share or commit .env.
#
# Ask Belfort (the explainer chat) uses YOUR OWN key. The easiest way is Settings inside the app,
# which keeps the key in your browser only. Setting it here instead makes it the default for this machine.

# Google Gemini (free key: https://aistudio.google.com/apikey)
# GEMINI_API_KEY=

# Or any OpenAI-compatible service: OpenAI, OpenRouter, Groq, or a local Ollama (no key needed)
# AI_PROVIDER=openai
# OPENAI_API_KEY=
# OPENAI_BASE_URL=http://localhost:11434/v1
# AI_MODEL=llama3.1

# Accounts and sync (optional; see docs/ACCOUNTS.md). The anon key is public by design; never use the service-role key.
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_ANON_KEY=

# Where Belfort keeps its database and cache (default: the data folder in this project)
# BELFORT_DATA_DIR=

# Only if you knowingly share Belfort on a private network: comma-separated access codes
# ACCESS_CODES=
