<?xml version="1.0" encoding="utf-8"?>
<!-- Belfort for Android (T48). Built without Gradle by android/build_apk.py; see android/README.md. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="app.belfort.android"
    android:versionCode="1"
    android:versionName="0.1.0">

    <uses-sdk android:minSdkVersion="26" android:targetSdkVersion="35" />

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:theme="@style/Theme.Belfort"
        android:allowBackup="false"
        android:debuggable="true"
        android:usesCleartextTraffic="true"
        android:supportsRtl="true">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode|density"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <receiver android:name=".ReminderReceiver" android:exported="false" />

        <provider
            android:name=".ShareProvider"
            android:authorities="app.belfort.android.share"
            android:exported="false"
            android:grantUriPermissions="true" />
    </application>
</manifest>
